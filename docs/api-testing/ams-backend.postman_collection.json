{
  "info": {
    "name": "AMS Backend API Verification",
    "_postman_id": "ams-backend-api-verification",
    "description": "End-to-end backend API verification for authentication, student, teacher, security, and validation scenarios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const runId = pm.environment.get('runId') || Date.now().toString(36);",
          "pm.environment.set('runId', runId);",
          "if (!pm.environment.get('registerUsername')) { pm.environment.set('registerUsername', `qa_collection_${runId}`); }",
          "if (!pm.environment.get('registerEmail')) { pm.environment.set('registerEmail', `qa.collection.${runId}@example.com`); }",
          "if (!pm.environment.get('assignmentDeadline')) { pm.environment.set('assignmentDeadline', new Date(Date.now() + 10 * 24 * 60 * 60 * 1000).toISOString()); }",
          "if (!pm.environment.get('attendanceDate')) { pm.environment.set('attendanceDate', new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString().slice(0, 10)); }",
          "if (!pm.environment.get('createdTeacherAssignmentId')) { pm.environment.set('createdTeacherAssignmentId', pm.environment.get('teacherAssignmentId') || ''); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth - Register unique student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{registerUsername}}\",\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"{{registerPassword}}\",\n  \"password2\": \"{{registerPassword}}\"\n}"
        },
        "event": [
          {
            "listen": "prerequest",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const runId = Date.now().toString(36);",
                "pm.environment.set('runId', runId);",
                "pm.environment.set('registerUsername', `qa_collection_${runId}`);",
                "pm.environment.set('registerEmail', `qa.collection.${runId}@example.com`);"
              ]
            }
          },
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status code is 201', () => pm.response.to.have.status(201));",
                "const body = pm.response.json();",
                "pm.test('Success flag is true', () => pm.expect(body.success).to.eql(true));",
                "pm.test('User payload exists', () => pm.expect(body.data.user).to.exist);"
              ]
            }
          }
        ]
      }
    },
    {
      "name": "Auth - Login unique student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{registerEmail}}\",\n  \"password\": \"{{registerPassword}}\"\n}"
        },
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.test('Success flag is true', () => pm.expect(body.success).to.eql(true));",
                "pm.test('Token payload exists', () => pm.expect(body.data.access).to.exist && pm.expect(body.data.refresh).to.exist);",
                "pm.environment.set('authAccess', body.data.access);",
                "pm.environment.set('authRefresh', body.data.refresh);"
              ]
            }
          }
        ]
      }
    },
